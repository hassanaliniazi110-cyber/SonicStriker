# Copy these settings into your hosting provider's environment variables.
# Do not commit a real .env file or secrets to GitHub.
PORT=11914
ALLOWED_ORIGINS=https://hassanaliniazi110-cyber.github.io
MAX_PLAYERS=5000
# Set this to the OWNER'S SonicStriker player ID after registering in SonicStriker.
YOUTUBE_ADMIN_PLAYER_ID=
# Optional additional owner IDs, comma/semicolon/newline separated.
YOUTUBE_ADMIN_PLAYER_IDS=
# Optional: keep player/access data in the hosting provider's persistent storage.
# SONICSTRIKER_DATA_FILE=/path/to/sonicstriker-data.json
# YOUTUBE_ACCESS_FILE=/path/to/sonicstriker-youtube-access.json
